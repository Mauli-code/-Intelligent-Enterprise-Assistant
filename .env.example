# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# auto   -> use Gemini when GEMINI_API_KEY is set, otherwise the offline engine
# local  -> always use the offline NLP engine (no network, deterministic)
# gemini -> use Gemini and fall back to the offline engine on timeout/failure
AI_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hard cap for a single provider call. The request also has a local fallback,
# so the five-second response budget is preserved.
AI_TIMEOUT_MS=4000

# ---------------------------------------------------------------------------
# Email second factor (2FA)
# ---------------------------------------------------------------------------
# console -> DEVELOPMENT ONLY. No email is sent; the code is printed to the
#            server console and returned to the browser. Refused in production.
# smtp    -> real email delivery through the SMTP settings below.
AUTH_EMAIL_MODE=console
IEA_DEV_OTP=true

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=assistant@example.com

# ---------------------------------------------------------------------------
# Optional overrides
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3001/api/chat
# PORT=3001
# DATABASE_PATH=./server/data/assistant.db
# IEA_KNOWLEDGE_DIR=./knowledge
# Comma-separated list of allowed browser origins. Empty reflects any origin,
# which is convenient for local development only.
# CORS_ORIGIN=http://localhost:5173
