{
  "name": "intelligent-enterprise-assistant",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "test": "NODE_ENV=test node --test server/index.test.js",
    "load-test": "node scripts/load-test.js",
    "desktop:package": "npm run build && electron-builder --mac dmg --arm64"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "badwords-list": "^2.0.1-4",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5"
  },
  "main": "desktop/main.cjs",
  "build": {
    "appId": "com.intelligententerpriseassistant.app",
    "productName": "Intelligent Enterprise Assistant",
    "asar": true,
    "files": [
      "dist/**/*",
      "server/**/*",
      "knowledge/**/*",
      "desktop/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/*.test.js",
      "!server/data/**",
      "!**/.env",
      "!**/.env.*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "dmg": {
      "title": "Intelligent Enterprise Assistant",
      "artifactName": "Intelligent-Enterprise-Assistant-${version}-${arch}.dmg"
    }
  }
}
